phaseone.localhost {
	tls internal

	handle /v1/* {
		reverse_proxy gateway:8080
	}
	handle /healthz {
		reverse_proxy gateway:8080
	}
	handle /readyz {
		reverse_proxy gateway:8080
	}
	handle /metrics {
		reverse_proxy gateway:8080
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

gateway.phaseone.localhost {
	tls internal
	reverse_proxy gateway:8080
}
