# PhaseOne10841 v0.2 — copy to .env and adjust

# Upstream LLM provider: mock | openai | ollama | openrouter
UPSTREAM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database (compose default)
DATABASE_URL=postgres://phaseone:phaseone@localhost:5432/phaseone

# Gateway / dashboard
GATEWAY_PORT=8080
DASHBOARD_PORT=3000
GATEWAY_URL=http://localhost:8080

# Policy override (optional)
# PHASEONE_POLICY_PATH=./policy/default-policy.yaml
