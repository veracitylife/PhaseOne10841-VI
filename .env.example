# PhaseOne10841 v0.7.0 — Veracity Integrity LLC · https://VeracityIntegrity.com
# Prefer: npm run onboard   (or: npm run onboard -- --defaults)

# --- Admin MFA (email OTP) + RBAC lite ---
# REQUIRED: set real operator emails (e.g. techpronow@gmail.com). admin@localhost is lab-only.
PHASEONE_ADMIN_EMAILS=admin@localhost
# Optional read-only operators:
# PHASEONE_VIEWER_EMAILS=viewer@example.com
PHASEONE_DASHBOARD_AUTH=true
# NEVER leave change-me in production — run: npm run onboard  (auto-generates a strong secret)
PHASEONE_SESSION_SECRET=change-me-run-onboard-to-generate
PHASEONE_OTP_FALLBACK_FILE=/tmp/phaseone-otp.log
# Set true when dashboard is served over HTTPS (Secure cookie flag)
PHASEONE_SECURE_COOKIES=false
# PHASEONE_SESSION_TTL_MS=28800000
# PHASEONE_OTP_TTL_MS=600000

# --- SMTP (leave SMTP_HOST empty ONLY for lab console OTP fallback) ---
# Production MFA sender (Veracity / Clovis Star):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=noreply@clovisstar.com
# SMTP_SECURE=false

# --- OIDC / SSO (Phase 6 Enterprise Auth Path) ---
# When enabled, OIDC works ALONGSIDE email OTP (does not replace it).
# Set all three required vars to enable OIDC login option.
# PHASEONE_OIDC_ISSUER=https://auth.example.com
# PHASEONE_OIDC_CLIENT_ID=phaseone-dashboard
# PHASEONE_OIDC_CLIENT_SECRET=your-client-secret
# PHASEONE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# PHASEONE_OIDC_SCOPES=openid email profile
# Optional endpoint overrides (auto-discovered from issuer if not set):
# PHASEONE_OIDC_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
# PHASEONE_OIDC_TOKEN_ENDPOINT=https://auth.example.com/oauth/token
# PHASEONE_OIDC_USERINFO_ENDPOINT=https://auth.example.com/userinfo
# Claim mapping:
# PHASEONE_OIDC_EMAIL_CLAIM=email
# PHASEONE_OIDC_ROLES_CLAIM=roles
# PHASEONE_OIDC_ADMIN_ROLE=phaseone-admin
# PHASEONE_OIDC_VIEWER_ROLE=phaseone-viewer
# Allow email OTP fallback when OIDC is enabled (default: true)
# PHASEONE_OIDC_ALLOW_OTP_FALLBACK=true

# --- Upstream LLM provider: mock | openai | ollama | openrouter ---
# Mock-first: keep mock until GET /healthz and GET /readyz are green, then switch.
UPSTREAM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Database (compose default) ---
DATABASE_URL=postgres://phaseone:phaseone@localhost:5432/phaseone

# --- Gateway / dashboard ---
GATEWAY_PORT=8080
DASHBOARD_PORT=3000
GATEWAY_URL=http://localhost:8080

# --- Phase 3 ---
PHASEONE_APPROVAL_TIMEOUT_MS=120000
# PHASEONE_SIEM_WEBHOOK_URL=https://siem.example/hooks/phaseone

# --- Phase 4 ---
# PHASEONE_ALERT_WEBHOOK_URL=https://hooks.example/phaseone-alerts
PHASEONE_RULES_DIR=./rules
PHASEONE_METRICS_ENABLED=true
# PHASEONE_ALERTS_ENABLED=true
# PHASEONE_ALERT_MAX_RETRIES=3
# PHASEONE_ALERT_BASE_DELAY_MS=250

# --- Phase 5 — retention, rate limits, backups ---
PHASEONE_RETENTION_DAYS=30
# PHASEONE_RETENTION_PRUNE_APPROVALS=true
# PHASEONE_RETENTION_PRUNE_AUDIT=true
# PHASEONE_RETENTION_DRY_RUN=false
PHASEONE_API_RATE_LIMIT=120
PHASEONE_API_RATE_WINDOW_MS=60000
PHASEONE_OTP_RATE_LIMIT=5
# PHASEONE_OTP_RATE_WINDOW_MS=900000
PHASEONE_BACKUP_DIR=./backups

# --- Phase 7 (Gatekeeper) ---
PHASEONE_GATEKEEPER_ENABLED=false
PHASEONE_GATEKEEPER_DRY_RUN=true
PHASEONE_PLAYBOOKS_DIR=./playbooks
# PHASEONE_GATEKEEPER_WEBHOOK_URL=
# PHASEONE_GATEKEEPER_POLL_MS=5000
# PHASEONE_GATEKEEPER_EVENT_WINDOW_MS=60000

# --- Phase 7 LLM Advisor (optional, advisory only) ---
# Primary: OpenRouter; Fallback: Ollama. LLM advises, playbooks decide.
# PHASEONE_GATEKEEPER_LLM_PRIMARY=openrouter
# PHASEONE_GATEKEEPER_LLM_FALLBACK=ollama
# PHASEONE_GATEKEEPER_OPENROUTER_MODEL=openrouter/auto
# PHASEONE_GATEKEEPER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PHASEONE_GATEKEEPER_OLLAMA_BASE_URL=http://100.124.238.112:11434/v1
# PHASEONE_GATEKEEPER_OLLAMA_MODEL=unrestricted:latest
# PHASEONE_GATEKEEPER_LLM_TIMEOUT_MS=30000
# PHASEONE_GATEKEEPER_LLM_MAX_TOKENS=512

# Policy override (optional)
# PHASEONE_POLICY_PATH=./policy/default-policy.yaml

# Adapter helpers
# PHASEONE_GATEWAY_URL=http://localhost:8080
# PHASEONE_AGENT_ID=my-agent
