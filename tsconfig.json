{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "cli/**/*",
    "gateway/**/*",
    "policy/**/*",
    "recorder/**/*",
    "canaries/**/*",
    "dashboard/**/*",
    "shared/**/*",
    "db/**/*",
    "examples/**/*",
    "tests/**/*",
    "lab/**/*",
    "mcp-server/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
