    "smoke": "tsx scripts/smoke.ts",
    "retention": "tsx scripts/retention-cleanup.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "gatekeeper": "tsx scripts/gatekeeper.ts",
    "operator-mcp": "tsx mcp-server/src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
